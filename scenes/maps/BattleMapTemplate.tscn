shader_parameter/albedo = Color(0.2, 0.2, 0.2, 1)
shader_parameter/grid_color = Color(0.5, 0.5, 0.5, 1)
shader_parameter/grid_size = 25.0
shader_parameter/line_thickness = 0.5

