size = 15.0

[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;

uniform vec3 albedo : source_color = vec3(0.2, 0.2, 0.2);
uniform vec3 grid_color : source_color = vec3(0.6, 0.6, 0.6);
uniform float grid_size = 10.0; // Adjust based on UV scaling
uniform float line_thickness = 0.02;

void fragment() {
	vec2 uv = UV;
	vec2 grid = abs(fract(uv * grid_size - 0.5) - 0.5) / fwidth(uv * grid_size);
	float line = min(grid.x, grid.y);
	float alpha = 1.0 - smoothstep(line_thickness, line_thickness + 1.0, line);
	
	ALBEDO = mix(albedo, grid_color, alpha);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_floor"]
render_priority = 0
